# .pulse — just fill in the required values and you're good

# Your bot token from https://discord.com/developers
DISCORD_TOKEN=your_bot_token_here

# Your application ID from https://discord.com/developers
CLIENT_ID=your_application_id_here

# Discord OAuth2 (for dashboard authentication)
# Create an application at https://discord.com/developers/applications
# Add redirect URI: https://your-domain.com/auth/discord/callback
DISCORD_CLIENT_ID=your_application_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here
DISCORD_REDIRECT_URI=http://localhost:9875/auth/discord/callback

# Session secret for dashboard (generate with: openssl rand -hex 32)
SESSION_SECRET=your_session_secret_here

# Database — MySQL connection URL (REQUIRED, MySQL only; SQLite is gone)
# Format: mysql://username:password@host:port/database
#
# This MUST be a mysql:// URL. A bare "./pulse.db" or "localhost" is the old
# Prisma/SQLite config and will fail to start the bot.
#
# Running in a container? 127.0.0.1 points at the container itself, so it can
# never reach a MySQL on another host — use that server's hostname or IP:
#   DATABASE_URL=mysql://pulse:change-me@mysql:3306/pulse
DATABASE_URL="mysql://pulse:change-me@localhost:3306/pulse"

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Dashboard port
DASHBOARD_PORT=9875
