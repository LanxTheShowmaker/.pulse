# .pulse — Pulse Variant 2 Configuration

# Required: Discord Bot Token (from Developer Portal → Bot → Token)
DISCORD_TOKEN=your_bot_token_here

# Required: Database URL (SQLite file path)
# Default creates data.db in project root
DATABASE_URL="file:./data.db"

# Optional: Application ID (Client ID) for command deployment
# Needed for global command deployment
CLIENT_ID=your_application_id_here

# Optional: Development guild ID for instant command deploy
# Omit for global deployment (1h propagation)
# GUILD_ID=your_dev_guild_id_here

# Optional: Log level (debug, info, warn, error)
LOG_LEVEL=info

# Optional: Web dashboard (future use)
# PUBLIC_BASE_URL=http://localhost:3000
# SESSION_SECRET=generate_a_long_random_string_here