# .pulse — just fill in the required values and you're good

# Your bot token from https://discord.com/developers
DISCORD_TOKEN=your_bot_token_here

# Your application ID from https://discord.com/developers
CLIENT_ID=your_application_id_here

# Discord OAuth2 (for dashboard authentication)
# Create an application at https://discord.com/developers/applications
# Add redirect URI: https://your-domain.com/auth/discord/callback
DISCORD_CLIENT_ID=your_application_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here
DISCORD_REDIRECT_URI=http://localhost:9875/auth/discord/callback

# Session secret for dashboard (generate with: openssl rand -hex 32)
SESSION_SECRET=your_session_secret_here

# Database — don't touch unless you know what you're doing
DATABASE_URL="file:./pulse.db"

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Dashboard port
DASHBOARD_PORT=9875
